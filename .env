# Server
SERVER_PORT=8080
SERVER_MODE=debug

# PostgreSQL
DATABASE_DSN=host=localhost user=flea password=flea_pass dbname=flea_market port=5432 sslmode=disable TimeZone=Asia/Shanghai

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=flea-market-jwt-secret-key-change-in-production-32chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=flea_admin
MINIO_SECRET_KEY=flea_admin_pass
MINIO_USE_SSL=false
MINIO_BUCKET=flea-avatars
